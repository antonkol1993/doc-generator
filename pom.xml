<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Наследуемся от Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/> <!-- важно! иначе Maven будет искать родительский pom локально -->
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mgt-group</groupId>
    <artifactId>doc-generator-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>doc-generator parent</name>
    <packaging>pom</packaging>

    <modules>
        <module>core</module>
        <module>javafx</module>
        <module>repo</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring.boot.version>3.2.4</spring.boot.version>
        <!-- Versions -->
        <apache.poi.version>5.2.3</apache.poi.version>
        <lombok.version>1.18.30</lombok.version>
        <javafx.version>21.0.7</javafx.version>
        <sqlite.jdbc.version>3.45.3.0</sqlite.jdbc.version>
        <hibernate.dialect.version>6.4.4.Final</hibernate.dialect.version>
        <junit.jupiter.version>5.9.3</junit.jupiter.version>
        <liquibase.version>4.30.0</liquibase.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot starter versions подтягиваются из родителя -->

            <dependency>
                <groupId>com.mgt-group</groupId>
                <artifactId>core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.jdbc.version}</version>
            </dependency>

            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-community-dialects</artifactId>
                <version>${hibernate.dialect.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi</artifactId>
                <version>${apache.poi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${apache.poi.version}</version>
            </dependency>

            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-core</artifactId>
                <version>${liquibase.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
