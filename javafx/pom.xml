    <dependencies>
        <!-- Связь с core -->
        <dependency>
            <groupId>com.mgt-group</groupId>
            <artifactId>doc-generator-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>
        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.ui.SpringJavaFxRunner</mainClass>
                    <jvmArguments>
                        --module-path C:\Users\user\.m2\repository\javafx-sdk-21.0.7\lib
                        --add-modules javafx.controls,javafx.fxml
                    </jvmArguments>
                </configuration>
            </plugin>
            <!-- JavaFX Maven Plugin -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version> <!-- Используем старую версию -->
                <configuration>
                    <mainClass>com.ui.SpringJavaFxRunner</mainClass>
<!--                    <options>-->
<!--                        <option>&#45;&#45;module-path</option>-->
<!--                        <option>C:/Users/user/.m2/repository/javafx-sdk-21.0.7</option>-->
<!--                        <option>&#45;&#45;add-modules</option>-->
<!--                        <option>javafx.controls,javafx.fxml</option>-->
<!--                    </options>-->

                </configuration>
            </plugin>
        </plugins>
    </build>




