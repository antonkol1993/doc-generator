        <artifactId>doc-generator-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>doc-generator-javafx</artifactId>
    <name>doc-generator javafx</name>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <start-class>com.ui.SpringJavaFxRunner</start-class>

    </properties>
