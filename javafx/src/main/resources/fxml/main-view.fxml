<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.antonio.interfacefx.controller.MainViewController"
            prefWidth="600" prefHeight="400">
    <children>
        <Button fx:id="readButton" text="Запустить чтение Excel" layoutX="50" layoutY="150"/>
        <Button text="Выбрать Excel" layoutX="250" layoutY="150" onAction="#onChooseFile"/>
        <Label fx:id="statusLabel" layoutX="50" layoutY="200" prefWidth="500"/>
    </children>
</AnchorPane>

